) +
labs(
title = "Average Effect by Length of Exposure",
x = "Years Since Adoption (τ)",
y = "ATT(τ)"
) +
theme_minimal(base_size = 13) +
theme(
panel.grid.minor = element_blank(),
plot.title = element_text(face = "bold", hjust = 0.5),
legend.position = "none"
)
